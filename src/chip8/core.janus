module chip8.core

import std.array
import std.result

enum Chip8Error derives Copy, Equality, Debug {
    RomTooLarge,
    MemoryOutOfBounds,
    StackOverflow,
    StackUnderflow,
    UnsupportedOpcode,
    InvalidRegister
}

private def unsignedByte(value : byte) : uint {
    val signed : int = int(value)
    if signed < 0 { return truncatingCast[uint](signed + 256) }
    return truncatingCast[uint](signed)
}

private def initialMemory() : Array[byte] {
    val result : Array[byte] =
    filledArray[byte](usize(4096), byte(0))
    val font : Array[byte] = [
        byte(0b1111_0000), byte(0b1001_0000), byte(0b1001_0000), byte(0b1001_0000), byte(0b1111_0000),
        byte(0b0010_0000), byte(0b0110_0000), byte(0b0010_0000), byte(0b0010_0000), byte(0b0111_0000),
        byte(0b1111_0000), byte(0b0001_0000), byte(0b1111_0000), byte(0b1000_0000), byte(0b1111_0000),
        byte(0b1111_0000), byte(0b0001_0000), byte(0b1111_0000), byte(0b0001_0000), byte(0b1111_0000),
        byte(0b1001_0000), byte(0b1001_0000), byte(0b1111_0000), byte(0b0001_0000), byte(0b0001_0000),
        byte(0b1111_0000), byte(0b1000_0000), byte(0b1111_0000), byte(0b0001_0000), byte(0b1111_0000),
        byte(0b1111_0000), byte(0b1000_0000), byte(0b1111_0000), byte(0b1001_0000), byte(0b1111_0000),
        byte(0b1111_0000), byte(0b0001_0000), byte(0b0010_0000), byte(0b0100_0000), byte(0b0100_0000),
        byte(0b1111_0000), byte(0b1001_0000), byte(0b1111_0000), byte(0b1001_0000), byte(0b1111_0000),
        byte(0b1111_0000), byte(0b1001_0000), byte(0b1111_0000), byte(0b0001_0000), byte(0b1111_0000),
        byte(0b1111_0000), byte(0b1001_0000), byte(0b1111_0000), byte(0b1001_0000), byte(0b1001_0000),
        byte(0b1110_0000), byte(0b1001_0000), byte(0b1110_0000), byte(0b1001_0000), byte(0b1110_0000),
        byte(0b1111_0000), byte(0b1000_0000), byte(0b1000_0000), byte(0b1000_0000), byte(0b1111_0000),
        byte(0b1110_0000), byte(0b1001_0000), byte(0b1001_0000), byte(0b1001_0000), byte(0b1110_0000),
        byte(0b1111_0000), byte(0b1000_0000), byte(0b1111_0000), byte(0b1000_0000), byte(0b1111_0000),
        byte(0b1111_0000), byte(0b1000_0000), byte(0b1111_0000), byte(0b1000_0000), byte(0b1000_0000)
    ]
    defer delete font
    var offset : usize = usize(0)
    while offset < font.size() {
        result.set(usize(0x50) + offset, font.get(offset))
        offset = offset + usize(1)
    }
    return move result
}

class Machine(seed : usize) {
    private val memory : Array[byte] = initialMemory()
    private val registers : Array[byte] =
    filledArray[byte](usize(16), byte(0))
    private val stack : Array[uint] = new Array[uint](usize(16))
    private val pixels : Array[bool] =
    filledArray[bool](usize(2048), false)
    private val keys : Array[bool] =
    filledArray[bool](usize(16), false)
    private var indexRegister : uint = uint(0)
    private var pc : uint = uint(512)
    private var delay : byte = byte(0)
    private var sound : byte = byte(0)
    private var randomState : usize = seed
    private var waitingRegister : int = -1
    private var loadAddress : uint = uint(512)

    def programCounter() : uint { return pc }
    def index() : uint { return indexRegister }
    def delayTimer() : byte { return delay }
    def soundTimer() : byte { return sound }
    def delayTimerUnsigned() : uint { return unsignedByte(delay) }
    def soundTimerUnsigned() : uint { return unsignedByte(sound) }
    def stackDepth() : usize { return stack.size() }
    def waitingForKey() : bool { return waitingRegister >= 0 }
    def registerUnsigned(index : usize) : uint { return unsignedByte(this.register(index)) }

    def currentOpcode() : uint {
        if pc > uint(0xFFE) { return uint(0) }
        return unsignedByte(memory.get(usize(pc))) << usize(8) |
        unsignedByte(memory.get(usize(pc + uint(1))))
    }

    def litPixelCount() : usize {
        var count : usize = usize(0)
        var cursor : usize = usize(0)
        while cursor < pixels.size() {
            if pixels.get(cursor) { count = count + usize(1) }
            cursor = cursor + usize(1)
        }
        return count
    }

    def register(index : usize) : byte {
        if index >= usize(16) { return byte(0) }
        return registers.get(index)
    }

    def memoryByte(address : usize) : byte {
        if address >= usize(4096) { return byte(0) }
        return memory.get(address)
    }

    def pixel(x : usize, y : usize) : bool {
        if x >= usize(64) || y >= usize(32) { return false }
        return pixels.get(y * usize(64) + x)
    }

    def setKey(key : usize, pressed : bool) : Result[bool, Chip8Error] {
        if key >= usize(16) {
            return Result.Error[bool, Chip8Error](Chip8Error.InvalidRegister)
        }
        keys.set(key, pressed)
        if pressed && waitingRegister >= 0 {
            registers.set(truncatingCast[usize](waitingRegister), truncatingCast[byte](key))
            waitingRegister = -1
            pc = pc + uint(2)
        }
        return Result.Ok[bool, Chip8Error](true)
    }

    def loadRom(data : Ptr[byte], size : usize) : Result[bool, Chip8Error] {
        if size > usize(3584) {
            return Result.Error[bool, Chip8Error](Chip8Error.RomTooLarge)
        }
        var cursor : usize = usize(0)
        while cursor < size {
            memory.set(usize(512) + cursor, data.load(cursor))
            cursor = cursor + usize(1)
        }
        pc = uint(512)
        loadAddress = uint(512) + truncatingCast[uint](size)
        return Result.Ok[bool, Chip8Error](true)
    }

    def loadOpcode(opcode : uint) : Result[bool, Chip8Error] {
        if loadAddress > uint(4094) {
            return Result.Error[bool, Chip8Error](Chip8Error.MemoryOutOfBounds)
        }
        memory.set(usize(loadAddress), truncatingCast[byte]((opcode >> usize(8)) & uint(0xFF)))
        memory.set(usize(loadAddress + uint(1)), truncatingCast[byte](opcode & uint(0xFF)))
        loadAddress = loadAddress + uint(2)
        return Result.Ok[bool, Chip8Error](true)
    }

    def tickTimers() : Unit {
        if unsignedByte(delay) > uint(0) {
            delay = truncatingCast[byte](unsignedByte(delay) - uint(1))
        }
        if unsignedByte(sound) > uint(0) {
            sound = truncatingCast[byte](unsignedByte(sound) - uint(1))
        }
    }

    private def nextRandomByte() : byte {
        randomState = randomState * usize(1664525) + usize(1013904223)
        return truncatingCast[byte]((randomState >> usize(8)) & usize(0xFF))
    }

    private def skipIf(condition : bool) : Unit {
        pc = pc + uint(2)
        if condition { pc = pc + uint(2) }
    }

    private def set8xy(index : usize, value : byte) : bool {
        registers.set(index, value)
        return true
    }

    private def add8xy(index : usize, left : byte, right : byte) : bool {
        val sum : uint = unsignedByte(left) + unsignedByte(right)
        registers.set(index, truncatingCast[byte](sum % uint(256)))
        registers.set(usize(15), byte(sum > uint(255)))
        return true
    }

    private def subtract8xy(index : usize, left : byte, right : byte) : bool {
        registers.set(usize(15), byte(unsignedByte(left) >= unsignedByte(right)))
        registers.set(index, truncatingCast[byte]((unsignedByte(left) + uint(256) - unsignedByte(right)) % uint(256)))
        return true
    }

    private def shiftRight8xy(index : usize, value : byte) : bool {
        registers.set(usize(15), truncatingCast[byte](unsignedByte(value) & uint(0x1)))
        registers.set(index, truncatingCast[byte](unsignedByte(value) >> usize(1)))
        return true
    }

    private def shiftLeft8xy(index : usize, value : byte) : bool {
        registers.set(usize(15), truncatingCast[byte]((unsignedByte(value) >> usize(7)) & uint(0x1)))
        registers.set(index, truncatingCast[byte](unsignedByte(value) << usize(1)))
        return true
    }

    def step() : Result[bool, Chip8Error] {
        if waitingRegister >= 0 { return Result.Ok[bool, Chip8Error](true) }
        if pc > uint(4094) {
            return Result.Error[bool, Chip8Error](Chip8Error.MemoryOutOfBounds)
        }
        val opcode : uint = unsignedByte(memory.get(usize(pc))) << usize(8) |
        unsignedByte(memory.get(usize(pc + uint(1))))
        val family : uint = opcode >> usize(12)
        val x : usize = usize((opcode >> usize(8)) & uint(0xF))
        val y : usize = usize((opcode >> usize(4)) & uint(0xF))
        val nn : byte = truncatingCast[byte](opcode & uint(0xFF))
        val nnn : uint = opcode & uint(0xFFF)
        val n : usize = usize(opcode & uint(0xF))

        if opcode == uint(0x00E0) {
            var cursor : usize = usize(0)
            while cursor < pixels.size() { pixels.set(cursor, false) cursor = cursor + usize(1) }
            pc = pc + uint(2)
            return Result.Ok[bool, Chip8Error](true)
        }
        if opcode == uint(0x00EE) {
            if stack.isEmpty() { return Result.Error[bool, Chip8Error](Chip8Error.StackUnderflow) }
            pc = stack.pop() + uint(2)
            return Result.Ok[bool, Chip8Error](true)
        }
        if family == uint(0x1) { pc = nnn return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0x2) {
            if stack.size() >= usize(16) { return Result.Error[bool, Chip8Error](Chip8Error.StackOverflow) }
            stack.push(pc) pc = nnn return Result.Ok[bool, Chip8Error](true)
        }
        if family == uint(0x3) { this.skipIf(registers.get(x) == nn) return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0x4) { this.skipIf(registers.get(x) != nn) return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0x5) && (opcode & uint(0xF)) == uint(0) { this.skipIf(registers.get(x) == registers.get(y)) return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0x6) { registers.set(x, nn) pc = pc + uint(2) return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0x7) { registers.set(x, truncatingCast[byte]((unsignedByte(registers.get(x)) + unsignedByte(nn)) % uint(256))) pc = pc + uint(2) return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0x8) {
            val sub : uint = opcode & uint(0xF)
            val vx : byte = registers.get(x)
            val vy : byte = registers.get(y)
            val supported : bool = match sub {
                uint(0) => this.set8xy(x, vy),
                uint(1) => this.set8xy(x, vx | vy),
                uint(2) => this.set8xy(x, vx & vy),
                uint(3) => this.set8xy(x, vx ^ vy),
                uint(4) => this.add8xy(x, vx, vy),
                uint(5) => this.subtract8xy(x, vx, vy),
                uint(6) => this.shiftRight8xy(x, vx),
                uint(7) => this.subtract8xy(x, vy, vx),
                uint(14) => this.shiftLeft8xy(x, vx),
                _ => false
            }
            if !supported {
                return Result.Error[bool, Chip8Error](Chip8Error.UnsupportedOpcode)
            }
            pc = pc + uint(2)
            return Result.Ok[bool, Chip8Error](true)
        }
        if family == uint(0x9) && (opcode & uint(0xF)) == uint(0) { this.skipIf(registers.get(x) != registers.get(y)) return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0xA) { indexRegister = nnn pc = pc + uint(2) return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0xB) { pc = unsignedByte(registers.get(usize(0))) + nnn return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0xC) { registers.set(x, this.nextRandomByte() & nn) pc = pc + uint(2) return Result.Ok[bool, Chip8Error](true) }
        if family == uint(0xD) {
            if indexRegister + truncatingCast[uint](n) > uint(4096) { return Result.Error[bool, Chip8Error](Chip8Error.MemoryOutOfBounds) }
            registers.set(usize(15), byte(0))
            var row : usize = usize(0)
            while row < n {
                val sprite : byte = memory.get(usize(indexRegister) + row)
                var column : usize = usize(0)
                while column < usize(8) {
                    if (unsignedByte(sprite) & (uint(0x80) >> column)) != uint(0) {
                        val px : usize = (usize(unsignedByte(registers.get(x))) + column) % usize(64)
                        val py : usize = (usize(unsignedByte(registers.get(y))) + row) % usize(32)
                        val position : usize = py * usize(64) + px
                        if pixels.get(position) { registers.set(usize(15), byte(1)) }
                        pixels.set(position, !pixels.get(position))
                    }
                    column = column + usize(1)
                }
                row = row + usize(1)
            }
            pc = pc + uint(2) return Result.Ok[bool, Chip8Error](true)
        }
        if family == uint(0xE) {
            val low : uint = opcode & uint(0xFF)
            val key : uint = unsignedByte(registers.get(x))
            if low == uint(0x9E) || low == uint(0xA1) {
                if key >= uint(16) {
                    return Result.Error[bool, Chip8Error](Chip8Error.InvalidRegister)
                }
                if low == uint(0x9E) {
                    this.skipIf(keys.get(usize(key)))
                }
                else {
                    this.skipIf(!keys.get(usize(key)))
                }
                return Result.Ok[bool, Chip8Error](true)
            }
        }
        if family == uint(0xF) {
            val low : uint = opcode & uint(0xFF)
            if low == uint(0x07) { registers.set(x, delay) }
            else if low == uint(0x0A) { waitingRegister = truncatingCast[int](x) return Result.Ok[bool, Chip8Error](true) }
            else if low == uint(0x15) { delay = registers.get(x) }
            else if low == uint(0x18) { sound = registers.get(x) }
            else if low == uint(0x1E) { indexRegister = indexRegister + unsignedByte(registers.get(x)) }
            else if low == uint(0x29) { indexRegister = uint(0x50) + unsignedByte(registers.get(x)) % uint(0x10) * uint(5) }
            else if low == uint(0x33) {
                if indexRegister > uint(4093) { return Result.Error[bool, Chip8Error](Chip8Error.MemoryOutOfBounds) }
                val value : byte = registers.get(x)
                memory.set(usize(indexRegister), truncatingCast[byte](unsignedByte(value) / uint(100)))
                memory.set(usize(indexRegister + uint(1)), truncatingCast[byte]((unsignedByte(value) / uint(10)) % uint(10)))
                memory.set(usize(indexRegister + uint(2)), truncatingCast[byte](unsignedByte(value) % uint(10)))
            }
            else if low == uint(0x55) {
                if indexRegister + truncatingCast[uint](x) >= uint(4096) { return Result.Error[bool, Chip8Error](Chip8Error.MemoryOutOfBounds) }
                var cursor : usize = usize(0)
                while cursor <= x { memory.set(usize(indexRegister) + cursor, registers.get(cursor)) cursor = cursor + usize(1) }
            }
            else if low == uint(0x65) {
                if indexRegister + truncatingCast[uint](x) >= uint(4096) { return Result.Error[bool, Chip8Error](Chip8Error.MemoryOutOfBounds) }
                var cursor : usize = usize(0)
                while cursor <= x { registers.set(cursor, memory.get(usize(indexRegister) + cursor)) cursor = cursor + usize(1) }
            }
            else { return Result.Error[bool, Chip8Error](Chip8Error.UnsupportedOpcode) }
            pc = pc + uint(2) return Result.Ok[bool, Chip8Error](true)
        }
        return Result.Error[bool, Chip8Error](Chip8Error.UnsupportedOpcode)
    }

    destructor {
        delete memory
        delete registers
        delete stack
        delete pixels
        delete keys
    }
}
