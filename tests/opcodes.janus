import chip8.core
import std.testing

private def opcode(machine : Machine, value : uint) : Unit {
    assertOk[bool, Chip8Error](machine.loadOpcode(value))
}

private def run(machine : Machine, count : usize) : Unit {
    var cursor : usize = usize(0)
    while cursor < count {
        assertOk[bool, Chip8Error](machine.step())
        cursor = cursor + usize(1)
    }
}

/// @test
def skipsAndJumps() : Unit {
    val machine : Machine = new Machine(usize(3))
    defer delete machine
    opcode(machine, uint(0x6001))
    opcode(machine, uint(0x3001))
    opcode(machine, uint(0x6000))
    opcode(machine, uint(0x4002))
    opcode(machine, uint(0x6000))
    opcode(machine, uint(0x1200))
    run(machine, usize(4))
    assertEqual[byte](machine.register(usize(0)), byte(1))
    assertEqual[uint](machine.programCounter(), uint(512))
}

/// @test
def registerAndArithmeticFamilies() : Unit {
    val machine : Machine = new Machine(usize(3))
    defer delete machine
    opcode(machine, uint(0x600A))
    opcode(machine, uint(0x6103))
    opcode(machine, uint(0x8010))
    opcode(machine, uint(0x8011))
    opcode(machine, uint(0x8012))
    opcode(machine, uint(0x8013))
    opcode(machine, uint(0x8014))
    opcode(machine, uint(0x8015))
    opcode(machine, uint(0x8016))
    opcode(machine, uint(0x8017))
    opcode(machine, uint(0x801E))
    run(machine, usize(11))
    assertEqual[byte](machine.register(usize(0)), byte(6))
}

/// @test
def callReturnAndStackErrors() : Unit {
    val machine : Machine = new Machine(usize(4))
    defer delete machine
    opcode(machine, uint(0x2204))
    opcode(machine, uint(0x1200))
    opcode(machine, uint(0x6007))
    opcode(machine, uint(0xEE))
    run(machine, usize(4))
    assertEqual[byte](machine.register(usize(0)), byte(7))
    assertEqual[usize](machine.stackDepth(), usize(0))
    val empty : Machine = new Machine(usize(4))
    defer delete empty
    opcode(empty, uint(0xEE))
    assertError[bool, Chip8Error](empty.step())
}

/// @test
def timersIndexRandomAndKeyWait() : Unit {
    val machine : Machine = new Machine(usize(123))
    defer delete machine
    opcode(machine, uint(0x6005))
    opcode(machine, uint(0xF015))
    opcode(machine, uint(0xF018))
    opcode(machine, uint(0xA0FF))
    opcode(machine, uint(0xC0F0))
    opcode(machine, uint(0xF10A))
    run(machine, usize(6))
    assertEqual[byte](machine.delayTimer(), byte(5))
    assertEqual[byte](machine.soundTimer(), byte(5))
    assertEqual[uint](machine.index(), uint(255))
    assertTrue(machine.waitingForKey())
    assertOk[bool, Chip8Error](machine.setKey(usize(10), true))
    assertFalse(machine.waitingForKey())
    assertEqual[byte](machine.register(usize(1)), byte(10))
    machine.tickTimers()
    assertEqual[byte](machine.delayTimer(), byte(4))
}

/// @test
def timersDecrementAcrossSignedByteBoundary() : Unit {
    val machine : Machine = new Machine(usize(124))
    defer delete machine
    opcode(machine, uint(0x6080))
    opcode(machine, uint(0xF015))
    run(machine, usize(2))
    machine.tickTimers()
    assertEqual[uint](machine.delayTimerUnsigned(), uint(127))
}

/// @test
def keyOpcodesRejectValuesOutsideChip8Keypad() : Unit {
    val pressedMachine : Machine = new Machine(usize(125))
    defer delete pressedMachine
    opcode(pressedMachine, uint(0x60FF))
    opcode(pressedMachine, uint(0xE09E))
    run(pressedMachine, usize(1))
    assertError[bool, Chip8Error](pressedMachine.step())

    val releasedMachine : Machine = new Machine(usize(126))
    defer delete releasedMachine
    opcode(releasedMachine, uint(0x60FF))
    opcode(releasedMachine, uint(0xE0A1))
    run(releasedMachine, usize(1))
    assertError[bool, Chip8Error](releasedMachine.step())
}

/// @test
def bcdAndRegisterStoreLoad() : Unit {
    val machine : Machine = new Machine(usize(5))
    defer delete machine
    opcode(machine, uint(0xA100))
    opcode(machine, uint(0x607B))
    opcode(machine, uint(0xF033))
    opcode(machine, uint(0x6001))
    opcode(machine, uint(0x6102))
    opcode(machine, uint(0xA110))
    opcode(machine, uint(0xF155))
    opcode(machine, uint(0x6000))
    opcode(machine, uint(0x6100))
    opcode(machine, uint(0xF165))
    run(machine, usize(3))
    assertEqual[byte](machine.memoryByte(usize(256)), byte(1))
    assertEqual[byte](machine.memoryByte(usize(257)), byte(2))
    assertEqual[byte](machine.memoryByte(usize(258)), byte(3))
    run(machine, usize(7))
    assertEqual[byte](machine.register(usize(0)), byte(1))
    assertEqual[byte](machine.register(usize(1)), byte(2))
}

/// @test
def spriteDrawWrapAndCollision() : Unit {
    val machine : Machine = new Machine(usize(6))
    defer delete machine
    val rom : Ptr[byte] = alloc[byte](usize(11))
    defer free(rom)
    rom.store(usize(0), byte(0xA2))
    rom.store(usize(1), byte(0x0A))
    rom.store(usize(2), byte(0x60))
    rom.store(usize(3), byte(0x3F))
    rom.store(usize(4), byte(0x61))
    rom.store(usize(5), byte(0x1F))
    rom.store(usize(6), byte(0xD0))
    rom.store(usize(7), byte(0x11))
    rom.store(usize(8), byte(0xD0))
    rom.store(usize(9), byte(0x11))
    rom.store(usize(10), byte(0b1100_0000))
    assertOk[bool, Chip8Error](machine.loadRom(rom, usize(11)))
    assertEqual[uint](machine.currentOpcode(), uint(0xA20A))
    run(machine, usize(4))
    assertTrue(machine.pixel(usize(63), usize(31)))
    assertTrue(machine.pixel(usize(0), usize(31)))
    assertEqual[byte](machine.register(usize(15)), byte(0))
    run(machine, usize(1))
    assertFalse(machine.pixel(usize(63), usize(31)))
    assertEqual[byte](machine.register(usize(15)), byte(1))
}

/// @test
def boundsUnsupportedAndFont() : Unit {
    val machine : Machine = new Machine(usize(7))
    defer delete machine
    val oversized : Ptr[byte] = alloc[byte](usize(3585))
    defer free(oversized)
    assertError[bool, Chip8Error](machine.loadRom(oversized, usize(3585)))
    opcode(machine, uint(0x0))
    assertError[bool, Chip8Error](machine.step())
    assertEqual[byte](machine.memoryByte(usize(0x50)), byte(0b1111_0000))
}

/// @test
def stackAndMemoryBoundariesAreErrors() : Unit {
    val stackMachine : Machine = new Machine(usize(8))
    defer delete stackMachine
    opcode(stackMachine, uint(0x2200))
    var depth : usize = usize(0)
    while depth < usize(16) {
        assertOk[bool, Chip8Error](stackMachine.step())
        depth = depth + usize(1)
    }
    assertEqual[usize](stackMachine.stackDepth(), usize(16))
    assertError[bool, Chip8Error](stackMachine.step())

    val memoryMachine : Machine = new Machine(usize(9))
    defer delete memoryMachine
    opcode(memoryMachine, uint(0xAFFF))
    opcode(memoryMachine, uint(0x60FF))
    opcode(memoryMachine, uint(0xF033))
    run(memoryMachine, usize(2))
    assertError[bool, Chip8Error](memoryMachine.step())
}
